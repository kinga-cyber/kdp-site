---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thank You for Voting | Kinga Dow"
  description="Thanks for casting your vote! Your pick helps shape the next webinar topic."
>
  <section class="hero-gradient relative overflow-hidden">
    <!-- Decorative circles -->
    <div class="absolute -left-20 top-16 w-[380px] h-[380px] opacity-30 pointer-events-none">
      <img src="/images/home/decorative/bg-circle-left.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>
    <div class="absolute -right-16 -bottom-16 w-[300px] h-[300px] opacity-20 pointer-events-none">
      <img src="/images/home/decorative/bg-circle.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>

    <div class="max-w-7xl mx-auto px-6 py-20 md:py-32 relative z-10">
      <div class="text-center max-w-2xl mx-auto">
        <!-- Checkmark -->
        <div class="animate-on-scroll scale-in w-16 h-16 rounded-full bg-kd-gold/10 border-2 border-kd-gold/30 flex items-center justify-center mx-auto mb-8">
          <svg class="w-8 h-8 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <!-- Heading -->
        <h1 class="animate-on-scroll fade-in-up delay-100 font-aktiv text-kd-navy text-[28px] md:text-[44px] font-bold leading-[36px] md:leading-[54px] tracking-[1px] md:tracking-[2px] mb-6">
          Thanks for Your Vote!
        </h1>

        <!-- Body -->
        <p class="animate-on-scroll fade-in-up delay-200 font-montserrat font-light text-kd-grey text-[16px] md:text-[18px] leading-[28px] md:leading-[32px] tracking-[0.8px] mb-4">
          Your pick has been recorded. I&rsquo;ll use this to shape the next webinar so it&rsquo;s exactly what you need.
        </p>

        <p class="animate-on-scroll fade-in-up delay-300 font-montserrat font-light text-kd-grey text-[16px] md:text-[18px] leading-[28px] md:leading-[32px] tracking-[0.8px] mb-10">
          Keep an eye on your inbox &mdash; I&rsquo;ll announce the topic and date soon.
        </p>

        <!-- Signature -->
        <p class="animate-on-scroll fade-in-up delay-400 font-montserrat text-kd-gold text-[14px] md:text-[15px] font-medium tracking-[0.8px] italic">
          &mdash; Kinga
        </p>
      </div>
    </div>
  </section>
</Layout>
