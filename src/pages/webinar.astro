---
import Layout from "../layouts/Layout.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is this webinar really free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, 100% free. No credit card required. Just register and show up."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to have attended the first webinar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. This webinar stands on its own. The first one covered campaigns. This one covers flows. Different topic, same approach."
      }
    },
    {
      "@type": "Question",
      "name": "What tools do I need?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Just a computer and an internet connection. I'll be demonstrating workflows using Claude, Klaviyo, Figma, and Asana, but you don't need accounts to follow along. Resources will be shared after the webinar."
      }
    },
    {
      "@type": "Question",
      "name": "Will there be a replay?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If you register but can't attend live, you'll receive the replay link by email."
      }
    },
    {
      "@type": "Question",
      "name": "Is this too technical for me?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. I show the workflow at the strategic level — what the system does and how the pieces connect. This isn't a coding tutorial."
      }
    }
  ]
};

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "From Doer to Director Part Two: Building Klaviyo Flows with AI",
  "description": "Free live webinar showing how to build Klaviyo flows using Claude AI as your strategist — from flow strategy to Asana briefs, Figma prototypes, and live deployment.",
  "startDate": "2026-04-02T17:00:00+02:00",
  "endDate": "2026-04-02T18:00:00+02:00",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
  "location": {
    "@type": "VirtualLocation",
    "url": "https://www.kingadow.com/webinar"
  },
  "organizer": {
    "@type": "Organization",
    "name": "Kinga Dow Productions",
    "url": "https://www.kingadow.com"
  },
  "performer": {
    "@type": "Person",
    "name": "Kinga Dow"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://www.kingadow.com/webinar"
  },
  "image": "https://www.kingadow.com/images/about/kinga-paris.jpg",
  "isAccessibleForFree": true
};
---

<Layout
  title="Free Webinar: From Doer to Director Part Two — AI-Powered Email Marketing with Claude | Kinga Dow"
  description="Free live webinar: Watch how Claude builds Klaviyo flow strategy, creates Asana briefs, generates Figma prototypes, and deploys everything into Klaviyo. From strategy to live flow."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

  <!-- Hero Section -->
  <section class="hero-gradient relative overflow-hidden">
    <!-- Decorative circle pattern - left side -->
    <div class="absolute -left-20 top-16 w-[380px] h-[380px] opacity-30 pointer-events-none">
      <img src="/images/home/decorative/bg-circle-left.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>
    <!-- Decorative circle pattern - bottom right -->
    <div class="absolute -right-16 -bottom-16 w-[300px] h-[300px] opacity-20 pointer-events-none">
      <img src="/images/home/decorative/bg-circle.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>

    <div class="max-w-7xl mx-auto px-6 py-12 md:py-20 relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <!-- Label: Gold uppercase -->
        <span class="animate-on-scroll fade-in-up font-aktiv text-kd-gold font-medium text-[14px] leading-[17px] tracking-[1.4px] mb-4 block uppercase">
          Free Live Webinar
        </span>

        <!-- H1 - Hero -->
        <h1 class="animate-on-scroll fade-in-up delay-100 font-aktiv text-kd-navy text-[24px] md:text-[40px] font-bold leading-[36px] md:leading-[52px] tracking-[1.4px] md:tracking-[2px] mb-6">
          From Doer to Director, Part Two:<br />Building Klaviyo Flows with AI
        </h1>

        <!-- Subtitle -->
        <p class="animate-on-scroll fade-in-up delay-200 font-montserrat text-kd-gold text-[18px] md:text-[24px] font-medium leading-[26px] md:leading-[32px] tracking-[1.4px] md:tracking-[1.8px] mb-6">
          Last time, I showed you campaigns. This time, it's flows.
        </p>

        <!-- Body text -->
        <p class="animate-on-scroll fade-in-up delay-300 font-montserrat font-light text-black text-[16px] md:text-[18px] mb-4 max-w-[800px] mx-auto leading-[26px] md:leading-[30px] tracking-[1.6px] md:tracking-[1.8px]">
          Watch me use Claude as my Klaviyo strategist — building flow strategy, creating Asana tasks with briefs, generating email prototypes in Figma for my designer, and deploying everything into Klaviyo.
        </p>
        <p class="animate-on-scroll fade-in-up delay-300 font-montserrat font-medium text-kd-navy text-[16px] md:text-[18px] mb-8 tracking-[1.6px] md:tracking-[1.8px] md:whitespace-nowrap">
          From strategy to live flow. One system.
        </p>

        <!-- CTA Button -->
        <a
          href="#register"
          class="animate-on-scroll fade-in-up delay-400 btn-navy inline-flex py-4 px-10 md:px-14 rounded-lg text-[14px] md:text-[16px] font-montserrat font-medium tracking-[1.4px] uppercase items-center gap-3"
        >
          Register Free
        </a>
      </div>
    </div>
  </section>

  <!-- Registration Section -->
  <section id="register" class="py-12 md:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-10">
        <!-- Date/Time Display -->
        <div class="animate-on-scroll fade-in-up bg-kd-cream/50 rounded-xl p-6 md:p-8 max-w-lg mx-auto mb-8">
          <p class="font-aktiv text-kd-navy text-[15px] font-semibold tracking-[0.8px] mb-1">
            Wednesday, April 2nd
          </p>
          <p class="font-aktiv text-kd-gold text-[28px] md:text-[32px] font-bold mb-1">
            5:00 PM CET
          </p>
          <p class="font-montserrat text-kd-grey text-[13px] tracking-[0.6px] mb-3">
            (11:00 AM EST)
          </p>
          <p class="font-montserrat text-kd-navy text-[14px] font-medium tracking-[0.6px]">
            Free · Live on Google Meet
          </p>
        </div>
      </div>

      <!-- Registration Form (Custom — Klaviyo API) -->
      <div class="max-w-lg mx-auto">
        <div class="animate-on-scroll fade-in-up delay-200 bg-kd-cream rounded-2xl p-8 md:p-10 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-kd-gold"></div>

          <h3 class="font-aktiv text-kd-navy text-[18px] md:text-[22px] font-semibold tracking-[1px] mb-6 text-center">
            Register Now — It's Free
          </h3>

          <form id="webinar-form" class="space-y-4">
            <!-- Honeypot -->
            <div style="position:absolute;left:-9999px;" aria-hidden="true">
              <input type="text" name="web_url" id="wb-website" tabindex="-1" autocomplete="off" />
            </div>

            <div>
              <input
                type="text"
                id="wb-first-name"
                placeholder="First Name"
                required
                class="w-full px-4 py-3 rounded-lg border border-kd-gold/30 bg-white font-montserrat text-[15px] text-black placeholder:text-kd-grey focus:outline-none focus:border-kd-gold transition-colors"
              />
            </div>

            <div>
              <input
                type="email"
                id="wb-email"
                placeholder="Email Address"
                required
                class="w-full px-4 py-3 rounded-lg border border-kd-gold/30 bg-white font-montserrat text-[15px] text-black placeholder:text-kd-grey focus:outline-none focus:border-kd-gold transition-colors"
              />
            </div>

            <button
              type="submit"
              id="wb-submit"
              class="w-full btn-navy py-4 rounded-lg text-[14px] md:text-[16px] font-montserrat font-medium tracking-[1.4px] uppercase"
            >
              Register Free
            </button>

            <p id="wb-error" class="hidden text-red-500 text-center font-montserrat text-[13px]"></p>
          </form>

          <!-- Success Message -->
          <div id="wb-success" class="hidden text-center py-4">
            <div class="w-16 h-16 bg-kd-gold/10 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h4 class="font-aktiv text-kd-navy text-[18px] font-semibold tracking-[0.8px] mb-2">You're Registered!</h4>
            <p class="font-montserrat text-black text-[14px] leading-[22px] font-light">
              Check your inbox for confirmation and calendar invite. See you there!
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What You'll Learn Section -->
  <section class="py-12 md:py-20 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="animate-on-scroll fade-in-up font-aktiv text-kd-navy text-[21px] md:text-[32px] font-semibold tracking-[1.2px] text-center mb-10">
        What You'll Learn
      </h2>

      <div class="grid md:grid-cols-2 gap-6 md:gap-8">
        <!-- Item 1 -->
        <div class="animate-on-scroll fade-in-up delay-100 bg-kd-cream/50 rounded-xl p-6 md:p-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.8px] mb-2">
                Claude as Your Klaviyo Strategist
              </h3>
              <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
                How I use Claude to figure out which flows to build, define the logic, and map out the full strategy — the same way a senior strategist would, but in minutes.
              </p>
            </div>
          </div>
        </div>

        <!-- Item 2 -->
        <div class="animate-on-scroll fade-in-up delay-200 bg-kd-cream/50 rounded-xl p-6 md:p-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.8px] mb-2">
                Flow Visualization
              </h3>
              <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
                How Claude builds visual flow charts — splits, triggers, timing, messaging paths — so you can see and approve the architecture before building anything.
              </p>
            </div>
          </div>
        </div>

        <!-- Item 3 -->
        <div class="animate-on-scroll fade-in-up delay-300 bg-kd-cream/50 rounded-xl p-6 md:p-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            </div>
            <div>
              <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.8px] mb-2">
                From Strategy to Asana Briefs
              </h3>
              <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
                How Claude turns the flow strategy into structured Asana tasks with briefs, assignments, and deadlines — so your team knows exactly what needs to happen.
              </p>
            </div>
          </div>
        </div>

        <!-- Item 4 -->
        <div class="animate-on-scroll fade-in-up delay-400 bg-kd-cream/50 rounded-xl p-6 md:p-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>
            <div>
              <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.8px] mb-2">
                AI-Powered Email Prototypes in Figma
              </h3>
              <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
                How Claude generates email starting points in Figma using the MCP extension — not finished designs, but structured prototypes that give your designer a head start instead of a blank canvas.
              </p>
            </div>
          </div>
        </div>

        <!-- Item 5 -->
        <div class="animate-on-scroll fade-in-up delay-100 bg-kd-cream/50 rounded-xl p-6 md:p-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.8px] mb-2">
                From Figma to Klaviyo in 3 Minutes
              </h3>
              <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
                How the finalized Figma design gets turned into a fully built Klaviyo template — sliced, compressed, alt-tagged, and ready to use. No HTML.
              </p>
            </div>
          </div>
        </div>

        <!-- Item 6 -->
        <div class="animate-on-scroll fade-in-up delay-200 bg-kd-cream/50 rounded-xl p-6 md:p-8">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <div>
              <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.8px] mb-2">
                The Full Pipeline: Strategy to Live Flow
              </h3>
              <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
                How all of this connects into one system — from Claude defining the strategy, to Asana tasks, to Figma prototypes, to a live Klaviyo flow. End to end.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- This Webinar Is For You If... -->
  <section class="py-12 md:py-16 px-6" style="background: linear-gradient(180deg, #F6EFE6 0%, #FAFAFA 100%);">
    <div class="max-w-5xl mx-auto">
      <h2 class="animate-on-scroll fade-in-up font-aktiv text-kd-navy text-[21px] md:text-[32px] font-semibold tracking-[1.2px] text-center mb-10">
        This Webinar Is For You If...
      </h2>

      <div class="grid md:grid-cols-2 gap-6 md:gap-8">
        <div class="animate-on-scroll fade-in-up delay-100 bg-white rounded-xl p-6 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
              You watched the first webinar and want to see how the system handles flows, not just campaigns
            </p>
          </div>
        </div>

        <div class="animate-on-scroll fade-in-up delay-200 bg-white rounded-xl p-6 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
              You're building Klaviyo flows manually and want a faster, more strategic approach
            </p>
          </div>
        </div>

        <div class="animate-on-scroll fade-in-up delay-300 bg-white rounded-xl p-6 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
              You want to see how Claude, Figma, Asana, and Klaviyo work together as one connected pipeline
            </p>
          </div>
        </div>

        <div class="animate-on-scroll fade-in-up delay-400 bg-white rounded-xl p-6 shadow-sm">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
              You're an agency owner or email marketer who wants to deliver more flows without adding more hours
            </p>
          </div>
        </div>

        <div class="animate-on-scroll fade-in-up delay-100 bg-white rounded-xl p-6 shadow-sm md:col-span-2 md:max-w-[calc(50%-0.75rem)]">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="font-montserrat text-black text-[15px] leading-[24px] font-light">
              You've heard about MCP connectors but haven't seen them used in a real production workflow
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Kinga Section -->
  <section class="py-12 md:py-16 px-6" style="background: linear-gradient(180deg, #FAFAFA 0%, #F6EFE6 100%);">
    <div class="max-w-5xl mx-auto">
      <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
        <!-- Left: Photo -->
        <div class="animate-on-scroll fade-in-up flex justify-center">
          <div class="w-[280px] h-[280px] md:w-[340px] md:h-[340px] rounded-full overflow-hidden border-4 border-kd-gold/20">
            <img
              src="/images/about/kinga-paris.jpg"
              alt="Kinga Dow - Founder of Kinga Dow Productions"
              class="w-full h-full object-cover"
              onerror="this.style.background='#F6EFE6'; this.alt='Kinga Dow';"
            />
          </div>
        </div>

        <!-- Right: Bio -->
        <div class="animate-on-scroll fade-in-up delay-100">
          <span class="font-aktiv text-kd-gold font-medium text-[14px] tracking-[1.4px] mb-3 block uppercase">
            Your Host
          </span>
          <h2 class="font-aktiv text-kd-navy text-[21px] md:text-[28px] font-semibold tracking-[1.2px] mb-4">
            Kinga Dow
          </h2>
          <p class="font-montserrat text-black text-[15px] md:text-[16px] leading-[26px] md:leading-[28px] font-light mb-4">
            Kinga founded her first web development agency in 2001 and has spent 20+ years in e-commerce. In 2017, she specialized in Klaviyo email marketing and built Kinga Dow Marketing into the first AI-native retention marketing agency.
          </p>
          <p class="font-montserrat text-black text-[15px] md:text-[16px] leading-[26px] md:leading-[28px] font-light mb-6">
            In the first "From Doer to Director" webinar, she walked through her AI-powered campaign workflow. Since then, the system has evolved — and this time she's showing how it handles the full flow production pipeline, from strategy through deployment.
          </p>

          <div class="flex flex-wrap gap-4">
            <div class="bg-white rounded-lg px-4 py-2 shadow-sm">
              <span class="font-aktiv text-kd-gold text-[18px] font-bold">20+</span>
              <span class="font-montserrat text-kd-grey text-[12px] ml-1">Years E-commerce</span>
            </div>
            <div class="bg-white rounded-lg px-4 py-2 shadow-sm">
              <span class="font-aktiv text-kd-gold text-[18px] font-bold">8+</span>
