---
import Standalone from "../layouts/Standalone.astro";
---

<Standalone
  title="AI Workflow ROI Calculator | Kinga Dow"
  description="Calculate how much time your Klaviyo agency can save by automating email marketing workflows with AI."
>

  <!-- ========================================
       DEMO BANNER
       ======================================== -->
  <div class="bg-kd-navy text-white text-center py-3 px-6">
    <span class="font-aktiv font-semibold text-[11px] md:text-[12px] tracking-[2px] uppercase">Interactive Tool</span>
    <span class="font-montserrat font-light text-white/60 text-[11px] md:text-[12px] tracking-[0.5px] ml-2 hidden md:inline">AI Workflow ROI Calculator by Kinga Dow</span>
  </div>

  <!-- ========================================
       HERO HEADER
       ======================================== -->
  <section class="hero-gradient relative overflow-hidden">
    <div class="absolute -left-20 top-16 w-[380px] h-[380px] opacity-30 pointer-events-none">
      <img src="/images/home/decorative/bg-circle-left.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>
    <div class="absolute -right-16 -bottom-16 w-[300px] h-[300px] opacity-20 pointer-events-none">
      <img src="/images/home/decorative/bg-circle.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>

    <div class="max-w-[900px] mx-auto px-6 py-10 md:py-14 relative z-10">
      <div class="animate-on-scroll fade-in-up flex flex-col items-center mb-6">
        <a href="/">
          <img src="/images/global/logo.png" alt="Kinga Dow" class="h-[60px] md:h-[80px]" />
        </a>
        <span class="font-montserrat text-kd-gold font-medium text-[13px] tracking-[1.4px] mt-2 uppercase">AI Integration</span>
      </div>

      <h1 class="animate-on-scroll fade-in-up delay-200 font-aktiv text-kd-navy text-[28px] md:text-[48px] font-bold leading-[36px] md:leading-[58px] tracking-[1px] md:tracking-[1.8px] mb-6">
        AI Workflow ROI<br class="md:hidden" /> Calculator<br />for Email Marketing Agencies
      </h1>

      <p class="animate-on-scroll fade-in-up delay-300 font-montserrat font-light text-kd-grey text-[16px] md:text-[18px] leading-[26px] md:leading-[30px] tracking-[0.8px] max-w-[640px]">
        Drag the sliders to match your agency. See what happens when you automate just 3 workflow steps.
      </p>
    </div>
  </section>

  <!-- ========================================
       STICKY STATS + SLIDERS SECTION
       ======================================== -->
  <section id="roi-stats" class="md:sticky md:top-0 z-50 py-3 md:py-4 bg-white/95 backdrop-blur-sm transition-shadow duration-300 border-b border-gray-200/60">
    <div class="max-w-[960px] mx-auto px-6">
      <!-- Sliders (input first) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-6">
        <div class="flex items-center gap-3">
          <label class="font-montserrat text-[11px] md:text-[12px] font-medium text-kd-navy tracking-[0.5px] whitespace-nowrap">Clients</label>
          <input type="range" id="clientsSlider" min="1" max="50" value="1" class="roi-slider flex-1" />
          <span id="clientsValue" class="min-w-[36px] text-center text-[18px] md:text-[22px] font-bold text-kd-navy font-montserrat tabular-nums">1</span>
        </div>
        <div class="flex items-center gap-3">
          <label class="font-montserrat text-[11px] md:text-[12px] font-medium text-kd-navy tracking-[0.5px] whitespace-nowrap">Campaigns/client</label>
          <input type="range" id="emailsSlider" min="5" max="120" value="40" class="roi-slider flex-1" />
          <span id="emailsValue" class="min-w-[36px] text-center text-[18px] md:text-[22px] font-bold text-kd-navy font-montserrat tabular-nums">40</span>
        </div>
      </div>

      <!-- Stats Cards -->
      <div class="mt-3 md:mt-4 grid grid-cols-3 gap-3 md:gap-4">
        <div class="stat-card border border-gray-200/80 rounded-xl p-3 md:p-5 text-center shadow-sm">
          <p id="statHours" class="font-montserrat text-[22px] md:text-[36px] font-bold text-kd-navy leading-none mb-1 tabular-nums">~61</p>
          <p class="font-montserrat text-[8px] md:text-[11px] font-semibold tracking-[1.5px] uppercase text-kd-grey/60">Hours saved / client</p>
          <p class="font-montserrat text-[9px] font-light text-kd-grey/50 italic mt-0.5 hidden md:block">per month</p>
        </div>
        <div class="stat-card border border-gray-200/80 rounded-xl p-3 md:p-5 text-center shadow-sm">
          <p id="statTotal" class="font-montserrat text-[22px] md:text-[36px] font-bold text-kd-navy leading-none mb-1 tabular-nums">~61</p>
          <p class="font-montserrat text-[8px] md:text-[11px] font-semibold tracking-[1.5px] uppercase text-kd-grey/60">Total hours saved</p>
          <p class="font-montserrat text-[9px] font-light text-kd-grey/50 italic mt-0.5 hidden md:block">all clients / month</p>
        </div>
        <div class="stat-card border border-gray-200/80 rounded-xl p-3 md:p-5 text-center shadow-sm">
          <p id="statDays" class="font-montserrat text-[22px] md:text-[36px] font-bold text-kd-navy leading-none mb-1 tabular-nums">~8</p>
          <p class="font-montserrat text-[8px] md:text-[11px] font-semibold tracking-[1.5px] uppercase text-kd-grey/60">Working days saved</p>
          <p class="font-montserrat text-[9px] font-light text-kd-grey/50 italic mt-0.5 hidden md:block">all clients / month</p>
        </div>
      </div>

      <!-- Explainer Bar -->
      <div class="mt-3 md:mt-4 bg-kd-cream/60 border border-kd-gold/15 rounded-xl px-4 py-3 text-center">
        <p id="explainerBar" class="font-montserrat text-[13px] md:text-[14px] font-light text-kd-grey leading-[1.5]">
          That&rsquo;s like getting <strong class="font-semibold text-kd-navy">a few extra days of capacity each month</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- ========================================
       BREAKDOWN TABLE
       ======================================== -->
  <section class="py-12 md:py-16 bg-white px-6">
    <div class="max-w-[960px] mx-auto">
      <h2 class="animate-on-scroll fade-in-up font-aktiv text-kd-navy text-[22px] md:text-[32px] font-semibold tracking-[1px] leading-[30px] md:leading-[42px] mb-3">
        Time Savings Breakdown
      </h2>
      <p class="animate-on-scroll fade-in-up delay-100 font-montserrat font-light text-kd-grey text-[15px] md:text-[16px] leading-[26px] tracking-[0.8px] mb-8">
        Per-client monthly savings across three core workflow steps.
      </p>

      <div class="animate-on-scroll fade-in-up delay-200 overflow-x-auto">
        <table class="roi-table w-full border-collapse rounded-xl overflow-hidden border border-gray-200 min-w-[600px]">
          <thead class="bg-kd-navy">
            <tr>
              <th class="text-left py-3.5 px-4 text-white font-montserrat font-semibold text-[12px] tracking-[1px] uppercase">Task</th>
              <th class="py-3.5 px-4 text-white font-montserrat font-semibold text-[12px] tracking-[1px] uppercase">Manual</th>
              <th class="py-3.5 px-4 text-white font-montserrat font-semibold text-[12px] tracking-[1px] uppercase">With AI</th>
              <th class="py-3.5 px-4 text-white font-montserrat font-semibold text-[12px] tracking-[1px] uppercase">Saved</th>
              <th class="py-3.5 px-4 text-white font-montserrat font-semibold text-[12px] tracking-[1px] uppercase">Reduction</th>
            </tr>
          </thead>
          <tbody class="font-montserrat font-light text-kd-grey">
            <tr class="border-b border-gray-200">
              <td class="py-3.5 px-4 font-medium text-kd-navy">Project management setup</td>
              <td class="py-3.5 px-4 text-center tabular-nums" id="asanaManual">16.7 hrs</td>
              <td class="py-3.5 px-4 text-center tabular-nums" id="asanaAI">0.75 hrs</td>
              <td class="py-3.5 px-4 text-center tabular-nums font-semibold text-kd-sage" id="asanaSaved">~16 hrs</td>
              <td class="py-3.5 px-4 text-center tabular-nums font-semibold text-kd-sage" id="asanaReduction">95%</td>
            </tr>
            <tr class="border-b border-gray-200 bg-gray-50/50">
              <td colspan="5" class="py-2.5 px-4 text-[12px] font-light text-kd-grey/50 italic" id="asanaDetail">40 tasks &times; 25 min manual vs. parallel batch processing &mdash; 5 tasks simultaneously in 5 min per batch</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-3.5 px-4 font-medium text-kd-navy">Email building (design)</td>
              <td class="py-3.5 px-4 text-center tabular-nums" id="designManual">80 hrs</td>
              <td class="py-3.5 px-4 text-center tabular-nums" id="designAI">40 hrs</td>
              <td class="py-3.5 px-4 text-center tabular-nums font-semibold text-kd-sage" id="designSaved">40 hrs</td>
              <td class="py-3.5 px-4 text-center tabular-nums font-semibold text-kd-sage" id="designReduction">50%</td>
            </tr>
            <tr class="border-b border-gray-200 bg-gray-50/50">
              <td colspan="5" class="py-2.5 px-4 text-[12px] font-light text-kd-grey/50 italic" id="designDetail">40 emails &times; 2 hrs manual vs. 1 hr with AI-generated briefs and skeleton layouts</td>
            </tr>
            <tr class="border-b border-gray-200">
              <td class="py-3.5 px-4 font-medium text-kd-navy">Campaign deployment</td>
              <td class="py-3.5 px-4 text-center tabular-nums" id="klaviyoManual">6.7 hrs</td>
              <td class="py-3.5 px-4 text-center tabular-nums" id="klaviyoAI">1.3 hrs</td>
              <td class="py-3.5 px-4 text-center tabular-nums font-semibold text-kd-sage" id="klaviyoSaved">5.3 hrs</td>
              <td class="py-3.5 px-4 text-center tabular-nums font-semibold text-kd-sage" id="klaviyoReduction">80%</td>
            </tr>
            <tr class="bg-gray-50/50">
              <td colspan="5" class="py-2.5 px-4 text-[12px] font-light text-kd-grey/50 italic" id="klaviyoDetail">40 campaigns &times; 10 min manual vs. 2 min with AI automating campaign creation via API</td>
            </tr>
          </tbody>
          <tfoot>
            <tr class="bg-kd-navy text-white">
              <td class="py-3.5 px-4 font-montserrat font-semibold text-[14px]">Total per client</td>
              <td class="py-3.5 px-4 text-center font-montserrat font-semibold tabular-nums" id="totalManual">103.4 hrs</td>
              <td class="py-3.5 px-4 text-center font-montserrat font-semibold tabular-nums" id="totalAI">42 hrs</td>
              <td class="py-3.5 px-4 text-center font-montserrat font-bold tabular-nums bg-kd-sage" id="totalSaved">~61 hrs</td>
              <td class="py-3.5 px-4 text-center font-montserrat font-bold tabular-nums bg-kd-sage" id="totalReduction">59%</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>

  <!-- ========================================
       INSIGHT CARDS
       ======================================== -->
  <section class="py-12 md:py-16 px-6" style="background: linear-gradient(180deg, #F6EFE6 0%, #FAFAFA 100%);">
    <div class="max-w-[960px] mx-auto">
      <h2 class="animate-on-scroll fade-in-up font-aktiv text-kd-navy text-[22px] md:text-[32px] font-semibold tracking-[1px] leading-[30px] md:leading-[42px] mb-3">
        What this means for your agency.
      </h2>
      <p class="animate-on-scroll fade-in-up delay-100 font-montserrat font-light text-kd-grey text-[15px] md:text-[16px] leading-[26px] tracking-[0.8px] mb-8">
        The numbers above translate directly into operational capacity and growth potential.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="animate-on-scroll fade-in-up delay-100 bg-white border border-gray-200 rounded-xl p-7 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
          <span class="inline-block bg-kd-cream text-kd-gold text-[10px] font-bold tracking-[1px] uppercase px-2.5 py-1 rounded-md mb-3">Capacity</span>
          <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.5px] mb-3">Your team gets time back</h3>
          <p class="font-montserrat font-light text-kd-grey text-[14px] md:text-[15px] leading-[24px] tracking-[0.5px]">
            Per client, you save
            <span id="insightDays" class="inline-block bg-kd-sage/10 border border-kd-sage/20 text-kd-sage font-semibold px-2 py-0.5 rounded text-[14px]">7.7 days</span>
            of manual work every month &mdash; capacity your CRM managers can reinvest in strategy and creative.
          </p>
        </div>
        <div class="animate-on-scroll fade-in-up delay-200 bg-white border border-gray-200 rounded-xl p-7 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
          <span class="inline-block bg-kd-cream text-kd-gold text-[10px] font-bold tracking-[1px] uppercase px-2.5 py-1 rounded-md mb-3">Scale</span>
          <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.5px] mb-3">Handle more clients</h3>
          <p class="font-montserrat font-light text-kd-grey text-[14px] md:text-[15px] leading-[24px] tracking-[0.5px]">
            If each CRM manager saves
            <span id="insightHours" class="inline-block bg-kd-sage/10 border border-kd-sage/20 text-kd-sage font-semibold px-2 py-0.5 rounded text-[14px]">61 hrs</span>
            per client per month, going from 4 to 6+ brands becomes operationally realistic.
          </p>
        </div>
        <div class="animate-on-scroll fade-in-up delay-300 bg-white border border-gray-200 rounded-xl p-7 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
          <span class="inline-block bg-kd-cream text-kd-gold text-[10px] font-bold tracking-[1px] uppercase px-2.5 py-1 rounded-md mb-3">Growth</span>
          <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.5px] mb-3">Grow without growing headcount</h3>
          <p class="font-montserrat font-light text-kd-grey text-[14px] md:text-[15px] leading-[24px] tracking-[0.5px]">
            Across all your clients, that&rsquo;s
            <span id="insightTotalDays" class="inline-block bg-kd-sage/10 border border-kd-sage/20 text-kd-sage font-semibold px-2 py-0.5 rounded text-[14px]">7.7 working days</span>
            of freed capacity &mdash; without adding to payroll.
          </p>
        </div>
        <div class="animate-on-scroll fade-in-up delay-400 bg-white border border-gray-200 rounded-xl p-7 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5">
          <span class="inline-block bg-kd-cream text-kd-gold text-[10px] font-bold tracking-[1px] uppercase px-2.5 py-1 rounded-md mb-3">Potential</span>
          <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold tracking-[0.5px] mb-3">And this is just the start</h3>
          <p class="font-montserrat font-light text-kd-grey text-[14px] md:text-[15px] leading-[24px] tracking-[0.5px]">
            These numbers cover 3 steps. Flow audits, A/B testing, retention analysis, and copywriting automation add additional savings on top.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================
       CTA BANNER
       ======================================== -->
  <section class="py-16 md:py-20 px-6 bg-white">
    <div class="max-w-[800px] mx-auto">
      <div class="animate-on-scroll scale-in bg-kd-navy rounded-2xl p-10 md:p-14 text-center">
        <h2 class="font-aktiv text-white text-[22px] md:text-[32px] font-semibold tracking-[1px] leading-[30px] md:leading-[42px] mb-4">
          Ready to see these savings in action?
        </h2>
        <p class="font-montserrat font-light text-white/60 text-[15px] md:text-[16px] leading-[26px] tracking-[0.8px] mb-8 max-w-[560px] mx-auto">
          Book a free consultation to discuss how AI workflow automation can transform your agency&rsquo;s operations.
        </p>
        <a href="https://www.kingadow.com/#consultation" class="btn-gold py-4 px-10 rounded-lg text-[14px] md:text-[15px] tracking-[1.4px] inline-flex items-center gap-2">
          Book Consultation &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================
       FOOTER NOTE
       ======================================== -->
  <div class="text-center py-10 border-t border-gray-200">
    <p class="font-montserrat font-light text-kd-grey/50 text-[13px] md:text-[14px] tracking-[0.5px]">
      AI Workflow ROI Calculator by <a href="https://www.kingadow.com" class="text-kd-gold hover:text-kd-navy transition-colors font-medium">Kinga Dow</a> &mdash; AI-powered retention marketing for e-commerce.
    </p>
  </div>

</Standalone>

<!-- ========================================
     SCOPED STYLES
     ======================================== -->
<style>
  /* Stat card gradient */
  .stat-card {
    background: linear-gradient(135deg, #FFFFFF 0%, #F6EFE6 100%);
  }

  /* Slider styling — lighter, gold-accent version */
  .roi-slider {
    -webkit-appearance: none;
    appearance: none;
    height: 5px;
    border-radius: 3px;
    background: linear-gradient(to right, #E0B000, #BA9200);
    outline: none;
    cursor: pointer;
  }
  .roi-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: white;
    border: 3px solid #BA9200;
    box-shadow: 0 2px 6px rgba(186,146,0,0.25);
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .roi-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }
  .roi-slider::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: white;
    border: 3px solid #BA9200;
    box-shadow: 0 2px 6px rgba(186,146,0,0.25);
    cursor: pointer;
  }

  /* Tabular nums utility */
  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }
</style>

<!-- ========================================
     CALCULATOR LOGIC
     ======================================== -->
<script>
  const emailsSlider = document.getElementById('emailsSlider') as HTMLInputElement;
  const clientsSlider = document.getElementById('clientsSlider') as HTMLInputElement;
  const emailsValue = document.getElementById('emailsValue')!;
  const clientsValue = document.getElementById('clientsValue')!;

  function fmt(n: number): string {
    return n >= 10 ? Math.round(n).toLocaleString() : n.toFixed(1);
  }

  function peoplePhrase(days: number): string {
    const people = days / 21;
    if (people < 0.3) return 'a few extra days of capacity each month';
    if (people < 0.7) return 'almost half a team member\u2019s capacity back';
    if (people < 1.2) return 'roughly 1 full-time person\u2019s worth of work back \u2014 without hiring anyone';
    if (people < 1.8) return 'roughly 1.5 full-time people\u2019s worth of work back \u2014 without hiring anyone';
    const rounded = Math.round(people);
    return 'roughly ' + rounded + ' full-time people\u2019s worth of work back \u2014 without hiring anyone';
  }

  function calculate(): void {
    const emails = parseInt(emailsSlider.value);
    const clients = parseInt(clientsSlider.value);
    emailsValue.textContent = String(emails);
    clientsValue.textContent = String(clients);

    // Asana: 25 min manual per task, 5 parallel batches of 5 min
    const asanaManual = (emails * 25) / 60;
    const asanaAI = (Math.ceil(emails / 5) * 5) / 60;
    const asanaSaved = asanaManual - asanaAI;
    const asanaRed = Math.round((asanaSaved / asanaManual) * 100);

    // Design: 2 hrs manual, 1 hr with AI
    const designManual = emails * 2;
    const designAI = emails * 1;
    const designSaved = designManual - designAI;
    const designRed = Math.round((designSaved / designManual) * 100);

    // Klaviyo: 10 min manual, 2 min with AI
    const klaviyoManual = (emails * 10) / 60;
    const klaviyoAI = (emails * 2) / 60;
    const klaviyoSaved = klaviyoManual - klaviyoAI;
    const klaviyoRed = Math.round((klaviyoSaved / klaviyoManual) * 100);

    // Totals
    const totalManual = asanaManual + designManual + klaviyoManual;
    const totalAI = asanaAI + designAI + klaviyoAI;
    const totalSaved = totalManual - totalAI;
    const totalRed = Math.round((totalSaved / totalManual) * 100);
    const totalAllClients = totalSaved * clients;
    const totalDays = totalAllClients / 8;
    const perClientDays = totalSaved / 8;

    // Update table
    document.getElementById('asanaManual')!.textContent = fmt(asanaManual) + ' hrs';
    document.getElementById('asanaAI')!.textContent = fmt(asanaAI) + ' hrs';
    document.getElementById('asanaSaved')!.textContent = '~' + fmt(asanaSaved) + ' hrs';
    document.getElementById('asanaReduction')!.textContent = asanaRed + '%';
    document.getElementById('asanaDetail')!.textContent =
      emails + ' tasks × 25 min manual vs. parallel batch processing — 5 tasks simultaneously in 5 min per batch';

    document.getElementById('designManual')!.textContent = fmt(designManual) + ' hrs';
    document.getElementById('designAI')!.textContent = fmt(designAI) + ' hrs';
    document.getElementById('designSaved')!.textContent = fmt(designSaved) + ' hrs';
    document.getElementById('designReduction')!.textContent = designRed + '%';
    document.getElementById('designDetail')!.textContent =
      emails + ' emails × 2 hrs manual vs. 1 hr with AI-generated briefs and skeleton layouts';

    document.getElementById('klaviyoManual')!.textContent = fmt(klaviyoManual) + ' hrs';
    document.getElementById('klaviyoAI')!.textContent = fmt(klaviyoAI) + ' hrs';
    document.getElementById('klaviyoSaved')!.textContent = fmt(klaviyoSaved) + ' hrs';
    document.getElementById('klaviyoReduction')!.textContent = klaviyoRed + '%';
    document.getElementById('klaviyoDetail')!.textContent =
      emails + ' campaigns × 10 min manual vs. 2 min with AI automating campaign creation via API';

    document.getElementById('totalManual')!.textContent = fmt(totalManual) + ' hrs';
    document.getElementById('totalAI')!.textContent = fmt(totalAI) + ' hrs';
    document.getElementById('totalSaved')!.textContent = '~' + fmt(totalSaved) + ' hrs';
    document.getElementById('totalReduction')!.textContent = totalRed + '%';

    // Update stat cards
    document.getElementById('statHours')!.textContent = '~' + fmt(totalSaved);
    document.getElementById('statTotal')!.textContent = '~' + fmt(totalAllClients);
    document.getElementById('statDays')!.textContent = '~' + fmt(totalDays);

    // Update explainer bar
    const explainerBar = document.getElementById('explainerBar');
    if (explainerBar) {
      explainerBar.innerHTML = 'That\u2019s like getting <strong class="font-semibold text-kd-navy">' +
        peoplePhrase(totalDays) + '</strong>.';
    }

    // Update insights
    document.getElementById('insightHours')!.textContent = fmt(totalSaved) + ' hrs';
    document.getElementById('insightDays')!.textContent = fmt(perClientDays) + ' days';
    document.getElementById('insightTotalDays')!.textContent = fmt(totalDays) + ' working days';
  }

  emailsSlider.addEventListener('input', calculate);
  clientsSlider.addEventListener('input', calculate);

  // Initial calculation
  calculate();

  // Sticky shadow effect
  const roiStats = document.getElementById('roi-stats');
  if (roiStats) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          roiStats.classList.add('shadow-lg');
        } else {
          roiStats.classList.remove('shadow-lg');
        }
      },
      { threshold: 1, rootMargin: '-1px 0px 0px 0px' }
    );
    observer.observe(roiStats);
  }
</script>
