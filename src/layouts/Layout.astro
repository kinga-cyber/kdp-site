---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnimationObserver from "../components/AnimationObserver.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  keywords?: string[];
  canonicalOverride?: string;
}

const {
  title,
  description = "AI-powered retention marketing for e-commerce. We build systems that turn browsers into repeat buyers.",
  ogImage = "https://kingadow.com/images/global/global-og-image.jpg",
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
  keywords,
  canonicalOverride,
} = Astro.props;

const siteUrl = "https://kingadow.com";
const canonicalUrl =
  canonicalOverride ?? new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && (
      <meta name="keywords" content={keywords.join(", ")} />
    )}
    <link rel="icon" type="image/png" href="/images/global/logo.png" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Kinga Dow" />
    {ogType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {ogType === "article" && articleAuthor && (
      <meta property="article:author" content={articleAuthor} />
    )}
    {ogType === "article" && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS feed autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kinga Dow Blog"
      href="/rss.xml"
    />

    <!-- Google Fonts: Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Organization Schema (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Kinga Dow LLC",
      "alternateName": "Kinga Dow Productions",
      "description": "AI-powered retention marketing agency for e-commerce, specializing in Klaviyo for DTC brands.",
      "url": "https://kingadow.com",
      "logo": "https://kingadow.com/images/global/logo.png",
      "email": "hello@kingadow.com",
      "founder": { "@type": "Person", "name": "Kinga Dow" },
      "knowsAbout": [
        "Klaviyo",
        "Email Marketing",
        "Retention Marketing",
        "AI Automation",
        "E-commerce",
        "MCP Integrations"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Philadelphia",
        "addressRegion": "PA",
        "addressCountry": "US"
      },
      "sameAs": [
        "https://www.linkedin.com/in/kingadow/",
        "https://www.linkedin.com/company/kinga-dow-productions-inc-",
        "https://www.instagram.com/kdpmarketing",
        "https://substack.com/@kingadow",
        "https://www.youtube.com/@kingadowecommerce"
      ]
    })} />

    <!-- Per-page extra head content (JSON-LD, etc.) -->
    <slot name="head" />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D1HSSBWRMM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-D1HSSBWRMM');
    </script>

    <!-- Klaviyo tracking script -->
    <script async src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=SqUgaK"></script>
  </head>
  <body class="bg-white">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <AnimationObserver />
  </body>
</html>
