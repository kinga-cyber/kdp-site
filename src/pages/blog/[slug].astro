---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ConsultationCTA from "../../components/ConsultationCTA.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

// Compute reading time from rendered word count (average reader = 225 wpm)
const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 225));

// Format date
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

// Related posts: same category, exclude current, max 3, exclude drafts
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.data.category === post.data.category && p.id !== post.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// SEO + canonical
const siteUrl = "https://kingadow.com";
const postUrl = `${siteUrl}/blog/${post.id}`;
const absoluteImage = post.data.ogImage
  ? post.data.ogImage
  : `${siteUrl}${post.data.image}`;

// Author Person objects, keyed by author name
const authorRegistry: Record<
  string,
  { name: string; url?: string; jobTitle?: string; sameAs?: string[] }
> = {
  "Kinga Dow": {
    name: "Kinga Dow",
    url: `${siteUrl}/about`,
    jobTitle: "Founder & Klaviyo Master Certified Partner",
    sameAs: [
      "https://www.linkedin.com/in/kingadow/",
      "https://substack.com/@kingadow",
    ],
  },
  "Pola": {
    name: "Pola",
    jobTitle: "Email Marketing Specialist",
  },
};
const authorData = authorRegistry[post.data.author] ?? {
  name: post.data.author,
};

// BlogPosting JSON-LD
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  headline: post.data.title,
  description: post.data.metaDescription ?? post.data.excerpt,
  image: absoluteImage,
  author: {
    "@type": "Person",
    ...authorData,
  },
  publisher: {
    "@type": "Organization",
    name: "Kinga Dow Productions",
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/images/global/logo.png`,
    },
    url: siteUrl,
  },
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  wordCount,
  keywords: post.data.keywords,
  articleSection: post.data.category,
  inLanguage: "en-US",
};

// BreadcrumbList JSON-LD
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${siteUrl}/blog` },
    {
      "@type": "ListItem",
      position: 3,
      name: post.data.title,
      item: postUrl,
    },
  ],
};

// Layout props
const pageTitle = post.data.metaTitle ?? `${post.data.title} | Kinga Dow Blog`;
const pageDescription = post.data.metaDescription ?? post.data.excerpt;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={absoluteImage}
  ogType="article"
  articlePublishedTime={post.data.date.toISOString()}
  articleModifiedTime={(post.data.updated ?? post.data.date).toISOString()}
  articleAuthor="https://www.linkedin.com/in/kingadow/"
  articleSection={post.data.category}
  keywords={post.data.keywords}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(blogPostingSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>

  <!-- Hero / Article Header -->
  <article>
    <header class="relative py-12 md:py-20 overflow-hidden" style="background: linear-gradient(180deg, #F6EFE6 0%, #FAFAFA 100%);">
      <!-- Decorative circles -->
      <div class="absolute top-8 left-8 w-24 h-24 rounded-full border border-kd-gold/20"></div>
      <div class="absolute bottom-12 right-12 w-20 h-20 rounded-full border border-kd-gold/20"></div>

      <div class="max-w-4xl mx-auto px-6 relative z-10">
        <!-- Breadcrumb -->
        <nav class="animate-on-scroll fade-in-up mb-6" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-[13px] font-montserrat tracking-[0.6px]">
            <li><a href="/" class="text-kd-grey hover:text-kd-gold transition-colors">Home</a></li>
            <li class="text-kd-grey">/</li>
            <li><a href="/blog" class="text-kd-grey hover:text-kd-gold transition-colors">Blog</a></li>
            <li class="text-kd-grey">/</li>
            <li class="text-kd-gold">{post.data.category}</li>
          </ol>
        </nav>

        <!-- Category -->
        <span class="animate-on-scroll fade-in-up text-kd-gold text-[13px] md:text-[14px] font-montserrat font-medium tracking-[1.3px] uppercase">
          {post.data.category}
        </span>

        <!-- Title -->
        <h1 class="animate-on-scroll fade-in-up font-aktiv text-kd-navy text-[24px] md:text-[42px] leading-[36px] md:leading-[52px] tracking-[1.4px] md:tracking-[2.1px] font-semibold mt-3 mb-6">
          {post.data.title}
        </h1>

        <!-- Meta info -->
        <div class="animate-on-scroll fade-in-up delay-100 flex flex-wrap items-center gap-4 md:gap-6">
          <!-- Author -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-kd-cream flex items-center justify-center">
              <span class="text-kd-navy text-[14px] font-montserrat font-medium">
                {post.data.author.charAt(0)}
              </span>
            </div>
            <span class="text-kd-navy text-[14px] font-montserrat font-medium tracking-[0.7px]">
              {post.data.author}
            </span>
          </div>

          <span class="text-kd-grey">|</span>

          <!-- Date -->
          <span class="text-kd-grey text-[14px] font-montserrat tracking-[0.7px]">
            {formatDate(post.data.date)}
          </span>

          <span class="text-kd-grey hidden md:inline">|</span>

          <!-- Reading time (computed from word count) -->
          <span class="text-kd-grey text-[14px] font-montserrat tracking-[0.7px] hidden md:inline">
            {readingTime} min read
          </span>
        </div>
      </div>
    </header>

    <!-- Featured Image -->
    <div class="max-w-4xl mx-auto px-6 -mt-4 md:-mt-8 mb-10 relative z-20">
      <div class="animate-on-scroll fade-in-up aspect-[1200/630] bg-kd-cream rounded-xl overflow-hidden shadow-lg">
        <img
          src={post.data.image}
          alt={post.data.imageAlt ?? post.data.title}
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Article Content -->
    <div class="max-w-3xl mx-auto px-6 pb-16">
      <div class="prose prose-lg prose-kd">
        <Content />
      </div>

      <!-- Share Section -->
      <div class="animate-on-scroll fade-in-up mt-12 pt-8 border-t border-gray-200">
        <p class="text-kd-navy text-[14px] font-montserrat font-medium tracking-[0.7px] mb-4">
          Share this article
        </p>
        <div class="flex items-center gap-4">
          <!-- LinkedIn -->
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="w-10 h-10 rounded-full bg-kd-cream flex items-center justify-center hover:bg-kd-gold/20 transition-colors">
            <svg class="w-5 h-5 text-kd-navy" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>

          <!-- Twitter/X -->
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X/Twitter" class="w-10 h-10 rounded-full bg-kd-cream flex items-center justify-center hover:bg-kd-gold/20 transition-colors">
            <svg class="w-5 h-5 text-kd-navy" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>

          <!-- Copy Link -->
          <button onclick="navigator.clipboard.writeText(window.location.href); this.querySelector('span').textContent = 'Copied!'; setTimeout(() => this.querySelector('span').textContent = 'Copy link', 2000)" class="flex items-center gap-2 px-4 py-2 rounded-full bg-kd-cream hover:bg-kd-gold/20 transition-colors text-kd-navy text-[13px] font-montserrat font-medium tracking-[0.6px]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span>Copy link</span>
          </button>
        </div>
      </div>
    </div>
  </article>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="py-12 md:py-16 px-6 bg-[#FAFAFA]">
      <div class="max-w-6xl mx-auto">
        <h2 class="animate-on-scroll fade-in-up font-aktiv text-kd-navy text-[21px] md:text-[28px] font-semibold tracking-[1.2px] md:tracking-[1.4px] mb-8">
          Related Posts
        </h2>

        <div class="grid md:grid-cols-3 gap-6 md:gap-8">
          {relatedPosts.map((relatedPost, index) => (
            <article class="animate-on-scroll fade-in-up bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow" style={`animation-delay: ${index * 0.1}s;`}>
              <a href={`/blog/${relatedPost.id}`} class="block aspect-[1200/630] bg-kd-cream relative overflow-hidden">
                <img
                  src={relatedPost.data.image}
                  alt={relatedPost.data.imageAlt ?? relatedPost.data.title}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                />
              </a>

              <div class="p-5">
                <span class="text-kd-gold text-[11px] md:text-[12px] font-montserrat font-medium tracking-[1.1px] uppercase">
                  {relatedPost.data.category}
                </span>

                <h3 class="font-aktiv text-kd-navy text-[15px] md:text-[16px] font-semibold leading-[22px] md:leading-[24px] tracking-[0.75px] md:tracking-[0.8px] mt-2 mb-2">
                  <a href={`/blog/${relatedPost.id}`} class="hover:text-kd-gold transition-colors line-clamp-2">
                    {relatedPost.data.title}
                  </a>
                </h3>

                <p class="text-kd-grey text-[11px] md:text-[12px] font-montserrat tracking-[1.1px]">
                  {formatDate(relatedPost.data.date)}
                </p>
              </div>
            </article>
          ))}
        </div>

        <!-- Back to Blog -->
        <div class="animate-on-scroll fade-in-up text-center mt-10">
          <a href="/blog" class="btn-gold px-8 py-3.5 rounded-lg text-[14px] font-montserrat font-medium tracking-[1.4px] inline-flex items-center gap-3 hover:opacity-90 transition-opacity">
            <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span>BACK TO BLOG</span>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Consultation CTA -->
  <ConsultationCTA />
</Layout>


<style>
  /* Prose styles live in src/styles/global.css under "Prose Content Styles" */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
