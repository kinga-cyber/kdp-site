---
import Layout from "../layouts/Layout.astro";
import ConsultationCTA from "../components/ConsultationCTA.astro";
---

<Layout
  title="AI Systems for Retention Marketing | Kinga Dow"
  description="AI-powered systems that handle the repetitive parts of retention marketing — so we focus on strategy, creativity, and results. See how our systems work."
>
  <!-- ========================================
       HERO SECTION
       ======================================== -->
  <section class="hero-gradient relative overflow-hidden">
    <!-- Decorative circle pattern - left side -->
    <div class="absolute -left-20 top-16 w-[380px] h-[380px] opacity-30 pointer-events-none">
      <img src="/images/home/decorative/bg-circle-left.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>
    <!-- Decorative circle pattern - bottom right -->
    <div class="absolute -right-16 -bottom-16 w-[300px] h-[300px] opacity-20 pointer-events-none">
      <img src="/images/home/decorative/bg-circle.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>

    <div class="max-w-7xl mx-auto px-6 py-12 md:py-20 relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <!-- Label: Gold uppercase -->
        <span class="animate-on-scroll fade-in-up font-aktiv text-kd-gold font-medium text-[14px] leading-[17px] tracking-[1.4px] mb-4 block uppercase">
          How We Work
        </span>

        <!-- H1 -->
        <h1 class="animate-on-scroll fade-in-up delay-100 font-aktiv text-kd-navy text-[24px] md:text-[48px] font-bold leading-[36px] md:leading-[60px] tracking-[1.4px] md:tracking-[2.4px] mb-6">
          AI Systems
        </h1>

        <!-- Subtitle -->
        <h2 class="animate-on-scroll fade-in-up delay-200 font-montserrat text-kd-navy text-[18px] md:text-[24px] font-medium leading-[26px] md:leading-[32px] tracking-[1.4px] md:tracking-[1.8px] mb-8">
          This is how we work.
        </h2>

        <!-- Body text -->
        <p class="animate-on-scroll fade-in-up delay-300 font-montserrat font-light text-black text-[16px] md:text-[18px] mb-8 max-w-[880px] mx-auto leading-[26px] md:leading-[30px] tracking-[1.6px] md:tracking-[1.8px]">
          We've built AI-powered systems that handle the repetitive, time-consuming parts of retention marketing — so we can focus on strategy, creativity, and results.
        </p>

        <!-- CTA Button -->
        <a
          href="/contact/"
          class="animate-on-scroll fade-in-up delay-400 btn-navy inline-block py-4 px-10 rounded-full text-sm md:text-lg md:py-5 md:px-14"
        >
          Schedule a Consultation
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================
       TWO AUDIENCE VALUE PROPS
       ======================================== -->
  <section class="py-12 md:py-20 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12">
        <!-- For Brands -->
        <div class="animate-on-scroll fade-in-up delay-100 bg-kd-cream/50 rounded-2xl p-8 md:p-10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 class="font-aktiv text-kd-navy text-[18px] md:text-[22px] font-semibold tracking-[1px]">
              For Brands
            </h3>
          </div>
          <p class="font-montserrat text-black text-[15px] md:text-[16px] leading-[26px] md:leading-[28px] font-light">
            Faster execution, fewer errors, and more sophisticated strategies than a traditional team could deliver. The result: higher-performing campaigns and more revenue from your existing customers.
          </p>
        </div>

        <!-- For Agencies -->
        <div class="animate-on-scroll fade-in-up delay-200 bg-kd-cream/50 rounded-2xl p-8 md:p-10">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="font-aktiv text-kd-navy text-[18px] md:text-[22px] font-semibold tracking-[1px]">
              For Agencies
            </h3>
          </div>
          <p class="font-montserrat text-black text-[15px] md:text-[16px] leading-[26px] md:leading-[28px] font-light">
            The industry is shifting. Teams that build AI into their workflows deliver more, move faster, and win clients who expect modern execution. We're already there — and we're sharing what we've learned. The result: higher margins, better output, and a competitive edge that's hard to replicate.
          </p>
        </div>
      </div>

      <!-- Bottom statement -->
      <p class="animate-on-scroll fade-in-up delay-300 font-montserrat text-kd-navy text-[16px] md:text-[18px] font-medium leading-[26px] md:leading-[30px] tracking-[1.2px] text-center mt-10 max-w-3xl mx-auto">
        These systems don't just save time. They enable strategies that would have been too complex or too slow to execute manually.
      </p>
    </div>
  </section>

  <!-- ========================================
       AI SYSTEMS
       ======================================== -->
  <section class="py-12 md:py-20 relative overflow-hidden" style="background-color: #FAFAFA;">
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="animate-on-scroll fade-in-up font-aktiv text-kd-navy text-[21px] md:text-[32px] font-semibold tracking-[1.2px] mb-3">
          Our Systems
        </h2>
        <p class="animate-on-scroll fade-in-up delay-100 font-montserrat text-kd-grey text-[15px] md:text-[16px] font-light tracking-[0.8px]">
          Nine systems. Three categories. Everything from audit to deployment.
        </p>
      </div>

      <!-- ===== UNDERSTAND ===== -->
      <div class="mb-14 md:mb-20">
        <div class="animate-on-scroll fade-in-up mb-8 md:mb-10">
          <div class="flex items-center gap-4 mb-2">
            <div class="w-10 h-[3px] bg-kd-gold rounded-full"></div>
            <h3 class="font-aktiv text-kd-navy font-bold text-[22px] md:text-[28px] tracking-[1.4px] uppercase">Understand</h3>
          </div>
          <p class="font-montserrat text-kd-grey text-[15px] md:text-[16px] font-light italic tracking-[0.6px] ml-14">
            The systems that analyze your data, capture your brand, and track your competitors.
          </p>
        </div>

        <!-- Flow Audit — full-width hero card with chart -->
        <div class="animate-on-scroll fade-in-up delay-100 bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-kd-gold/10 mb-6">
          <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-start">
            <!-- Left: description -->
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                  </svg>
                </div>
                <h3 class="font-aktiv text-kd-navy text-[18px] md:text-[22px] font-semibold tracking-[0.8px]">
                  Klaviyo Flow Audit
                </h3>
              </div>
              <ul class="space-y-2.5 font-montserrat text-black text-[14px] md:text-[15px] leading-[24px] font-light">
                <li class="flex items-start gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                  Pulls 90 days of flow performance data automatically
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                  Scores every flow by revenue impact and priority level
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                  Identifies underperforming, missing, and inactive flows
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                  Delivers optimization briefs directly into your CRM
                </li>
              </ul>
            </div>

            <!-- Right: Flow Audit chart image -->
            <div>
              <img
                src="/images/ai-systems/Flow Health Audit — Light Gradient.png"
                alt="Klaviyo Flow Audit results showing 34 flows analyzed, 14 underperforming, 7 missing or inactive, and $171K in revenue opportunity"
                class="w-full rounded-2xl shadow-sm"
              />
            </div>
          </div>
        </div>

        <!-- Brand Foundation + Inbox Intelligence — 2 columns -->
        <div class="grid md:grid-cols-2 gap-6">
          <!-- Brand Foundation -->
          <div class="animate-on-scroll fade-in-up delay-200 bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-kd-gold/10">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
              <h3 class="font-aktiv text-kd-navy text-[17px] md:text-[20px] font-semibold tracking-[0.8px]">
                Brand Foundation
              </h3>
            </div>
            <ul class="space-y-2 font-montserrat text-black text-[14px] md:text-[15px] leading-[24px] font-light">
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Captures your brand voice, tone, and messaging framework
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Builds audience profiles from your actual customer data
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Structures everything so AI understands your business — not a generic version of it
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                The setup that makes every other system work
              </li>
            </ul>
          </div>

          <!-- Inbox Intelligence -->
          <div class="animate-on-scroll fade-in-up delay-300 bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-kd-gold/10">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="font-aktiv text-kd-navy text-[17px] md:text-[20px] font-semibold tracking-[0.8px]">
                Inbox Intelligence
              </h3>
            </div>
            <ul class="space-y-2 font-montserrat text-black text-[14px] md:text-[15px] leading-[24px] font-light">
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Captures every competitor email automatically
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Analyzes subject lines, send timing, campaign themes, and positioning gaps
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Tracks patterns across weeks and months
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Weekly reports showing exactly where to differentiate
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- ===== BUILD ===== -->
      <div class="mb-14 md:mb-20">
        <div class="animate-on-scroll fade-in-up mb-8 md:mb-10">
          <div class="flex items-center gap-4 mb-2">
            <div class="w-10 h-[3px] bg-kd-gold rounded-full"></div>
            <h3 class="font-aktiv text-kd-navy font-bold text-[22px] md:text-[28px] tracking-[1.4px] uppercase">Build</h3>
          </div>
          <p class="font-montserrat text-kd-grey text-[15px] md:text-[16px] font-light italic tracking-[0.6px] ml-14">
            The systems that create your assets, test your strategies, and produce complete flows and campaigns.
          </p>
        </div>

        <!-- Flow Production Pipeline — full-width hero card with image -->
        <div class="animate-on-scroll fade-in-up delay-100 bg-white rounded-2xl p-6 md:p-10 shadow-sm border border-kd-gold/10 mb-6">
          <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-start">
            <!-- Left: description -->
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </div>
                <h3 class="font-aktiv text-kd-navy text-[18px] md:text-[22px] font-semibold tracking-[0.8px]">
                  Flow Production Pipeline
                </h3>
              </div>
              <ul class="space-y-2.5 font-montserrat text-black text-[14px] md:text-[15px] leading-[24px] font-light">
                <li class="flex items-start gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                  Six steps from strategy to live Klaviyo flow
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                  AI builds architecture, visual maps, briefs, designs, HTML, and deploys
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                  You review at three checkpoints — everything between runs automatically
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                  A complete flow with all emails, built and deployed in one pipeline
                </li>
              </ul>
            </div>

            <!-- Right: Pipeline image -->
            <div>
              <img
                src="/images/ai-systems/Pipeline Card — Light Gradient.png"
                alt="Flow Production Pipeline showing 6 steps: Claude strategist, Flow visuals, Asana briefs, Figma prototypes, Automatic slice, and Klaviyo deploy"
                class="w-full rounded-2xl shadow-sm"
              />
            </div>
          </div>
        </div>

        <!-- Email Design System + A/B Testing Agent + Campaign Pipeline — 3 columns -->
        <div class="grid md:grid-cols-3 gap-6">
          <!-- Email Design System -->
          <div class="animate-on-scroll fade-in-up delay-200 bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-kd-gold/10">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
                </svg>
              </div>
              <h3 class="font-aktiv text-kd-navy text-[17px] md:text-[20px] font-semibold tracking-[0.8px]">
                Email Design System
              </h3>
            </div>
            <ul class="space-y-2 font-montserrat text-black text-[14px] md:text-[15px] leading-[24px] font-light">
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Rebuilds your entire email design language as a Figma component library
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Every layout, color, font, and content block structured for reuse
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                New emails assemble from brand-consistent parts instead of starting from scratch
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Set up once, used across every campaign and flow
              </li>
            </ul>
          </div>

          <!-- A/B Testing Agent -->
          <div class="animate-on-scroll fade-in-up delay-300 bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-kd-gold/10">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <h3 class="font-aktiv text-kd-navy text-[17px] md:text-[20px] font-semibold tracking-[0.8px]">
                A/B Testing Agent
              </h3>
            </div>
            <ul class="space-y-2 font-montserrat text-black text-[14px] md:text-[15px] leading-[24px] font-light">
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Identifies what to test across flows and campaigns
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Prioritizes tests by revenue impact, not guesswork
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Creates specs, monitors results, and logs everything automatically
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Turns random testing into a compounding revenue engine
              </li>
            </ul>
          </div>

          <!-- Campaign Pipeline -->
          <div class="animate-on-scroll fade-in-up delay-400 bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-kd-gold/10">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-kd-gold/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-kd-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="font-aktiv text-kd-navy text-[17px] md:text-[20px] font-semibold tracking-[0.8px]">
                Campaign Pipeline
              </h3>
            </div>
            <ul class="space-y-2 font-montserrat text-black text-[14px] md:text-[15px] leading-[24px] font-light">
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Marketing calendar to copy to CRM tasks to Klaviyo draft in one pass
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                One input, every system updated
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                Copy, tasks, and campaign drafts generated automatically
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-2 h-2 rounded-full bg-kd-gold mt-2 flex-shrink-0"></span>
                What used to take a team hours runs in minutes
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- ===== DEPLOY ===== -->
      <div>
        <div class="animate-on-scroll fade-in-up mb-8 md:mb-10">
          <div class="flex items-center gap-4 mb-2">
            <div class="w-10 h-[3px] bg-kd-gold rounded-full"></div>
            <h3 class="font-aktiv text-kd-navy font-bold text-[22px] md:text-[28px] tracking-[1.4px] uppercase">Deploy</h3>
          </div>
          <p class="font-montserrat text-kd-grey text-[15px] md:text-[16px] font-light italic tracking-[0.6px] ml-14">
            The systems that build and push finished work directly into Klaviyo — ready to review and send.
          </p>
