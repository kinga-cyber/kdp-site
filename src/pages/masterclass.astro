<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    // Audience type selector
    var btnBrand = document.getElementById('mc-btn-brand');
    var btnAgency = document.getElementById('mc-btn-agency');
    var audienceInput = document.getElementById('mc-audience-type');
    var audienceError = document.getElementById('mc-audience-error');

    function selectAudience(type) {
      audienceInput.value = type;
      audienceError.classList.add('hidden');

      // Reset both to dimmed state
      btnBrand.className = 'audience-btn px-4 py-4 rounded-lg font-montserrat text-[15px] font-semibold tracking-[0.8px] uppercase transition-all bg-kd-navy text-white opacity-40';
      btnAgency.className = 'audience-btn px-4 py-4 rounded-lg font-montserrat text-[15px] font-semibold tracking-[0.8px] uppercase transition-all bg-kd-sage text-white opacity-40';

      // Highlight selected with full opacity + ring + slight scale
      var activeBtn = type === 'brand' ? btnBrand : btnAgency;
      var baseColor = type === 'brand' ? 'bg-kd-navy' : 'bg-kd-sage';
      activeBtn.className = 'audience-btn px-4 py-4 rounded-lg font-montserrat text-[15px] font-semibold tracking-[0.8px] uppercase transition-all ' + baseColor + ' text-white opacity-100 ring-2 ring-offset-2 ring-kd-gold scale-[1.03]';
    }

    if (btnBrand) btnBrand.addEventListener('click', function() { selectAudience('brand'); });
    if (btnAgency) btnAgency.addEventListener('click', function() { selectAudience('agency'); });

    // Form submission
    var form = document.getElementById('mc-form');
    var submitBtn = document.getElementById('mc-submit');
    var errorMsg = document.getElementById('mc-error');
    var successMsg = document.getElementById('mc-success');

    // Klaviyo list IDs
    var webinarLeadsListId = 'VYmEWU';
    var newsletterListId = 'RxZsvW';

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        // Honeypot check
        var honeypot = document.getElementById('mc-website');
        if (honeypot && honeypot.value) {
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
          return;
        }

        var firstName = document.getElementById('mc-first-name').value.trim();
        var email = document.getElementById('mc-email').value.trim();
        var audienceType = document.getElementById('mc-audience-type').value;
        var newsletterConsent = document.getElementById('mc-newsletter').checked;

        if (!firstName || !email) return;

        // Validate audience type
        if (!audienceType) {
          audienceError.classList.remove('hidden');
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Loading...';
        errorMsg.classList.add('hidden');

        // Step 1: Create/update profile with audience_type
        fetch('https://a.klaviyo.com/client/profiles/?company_id=SqUgaK', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'revision': '2024-06-15'
          },
          body: JSON.stringify({
            data: {
              type: 'profile',
              attributes: {
                email: email,
                first_name: firstName,
                properties: {
                  audience_type: audienceType,
                  masterclass_registered: true,
                  masterclass_topic: 'from-doer-to-director-part-one-campaigns',
                  custom_source: 'Masterclass Landing Page'
                }
              }
            }
          })
        })
        .then(function() {
          // Step 2: Subscribe to Webinar Leads list
          return fetch('https://a.klaviyo.com/client/subscriptions/?company_id=SqUgaK', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'revision': '2024-06-15'
            },
            body: JSON.stringify({
              data: {
                type: 'subscription',
                attributes: {
                  custom_source: 'Masterclass Landing Page',
                  profile: {
                    data: {
                      type: 'profile',
                      attributes: {
                        email: email,
                        first_name: firstName
                      }
                    }
                  }
                },
                relationships: {
                  list: {
                    data: {
                      type: 'list',
                      id: webinarLeadsListId
                    }
                  }
                }
              }
            })
          });
        })
        .then(function() {
          // Step 3: If newsletter consent, also subscribe to Newsletter list
          if (newsletterConsent) {
            return fetch('https://a.klaviyo.com/client/subscriptions/?company_id=SqUgaK', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'revision': '2024-06-15'
              },
              body: JSON.stringify({
                data: {
                  type: 'subscription',
                  attributes: {
                    custom_source: 'Masterclass Newsletter Opt-in',
                    profile: {
                      data: {
                        type: 'profile',
                        attributes: {
                          email: email,
                          first_name: firstName
                        }
                      }
                    }
                  },
                  relationships: {
                    list: {
                      data: {
                        type: 'list',
                        id: newsletterListId
                      }
                    }
                  }
                }
              })
            });
          }
        })
        .then(function() {
          form.classList.add('hidden');
          successMsg.classList.remove('hidden');
        })
        .catch(function() {
          errorMsg.textContent = 'Something went wrong. Please try again.';
          errorMsg.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Watch the Replay';
        });
      });
    }
  });
</script>
