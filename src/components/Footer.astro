---
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: "HOME", href: "/" },
  { label: "SERVICES", href: "/services/" },
  { label: "AI SYSTEMS", href: "/ai-systems/" },
  { label: "CASE STUDIES", href: "/case-studies/" },
  { label: "ABOUT US", href: "/about/" },
  { label: "BLOG", href: "/blog/" },
  { label: "STRATEGY SESSION", href: "/consultation/" },
  { label: "CONTACT US", href: "/contact/" },
];

const toolLinks = [
  { label: "Retention Maturity Calculator", href: "/calculator/" },
  { label: "AI Workflow ROI Calculator", href: "/roi-calculator/" },
  { label: "Free Resource", href: "/resource/" },
  { label: "A/B Testing Blueprint", href: "/blueprint/" },
  { label: "Flow Health Monitor", href: "/demo/flow-health-monitor/" },
  { label: "Portfolio", href: "/portfolio/" },
];
---

<footer class="bg-white pt-6 md:pt-10 pb-0">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Logo -->
    <div class="flex justify-center mb-8">
      <a href="/">
        <img
          src="/images/global/logo.png"
          alt="Kinga Dow - Exponential Brand Growth"
          class="h-[100px]"
        />
      </a>
    </div>

    <!-- Mission statement — line breaks match Figma screenshot -->
    <div class="text-center mb-10">
      <p class="text-black text-[12px] md:text-[14px] leading-[20px] md:leading-[24px] tracking-[0.7px] md:tracking-[1.4px] max-w-xl mx-auto font-montserrat font-light">
        We work with conscious clients,<span class="md:hidden"><br /></span> so we have to be conscious too.<span class="hidden md:inline"><br /></span><span class="md:hidden"><br /></span>A world where businesses are fair, ethical,<span class="md:hidden"><br /></span> and empowering to all.
      </p>
    </div>

    <!-- Social Links — cream circle backgrounds -->
    <div class="flex justify-center gap-4 mb-10">
      <!-- Substack -->
      <a href="https://substack.com/@kingadow" aria-label="Substack" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full bg-kd-cream flex items-center justify-center hover:opacity-80 transition-opacity">
        <img src="/images/global/substack-icon.png" alt="Substack" class="w-8 h-8 object-contain" />
      </a>
      <!-- YouTube -->
      <a href="https://www.youtube.com/@kingadowecommerce" aria-label="YouTube" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full bg-kd-cream flex items-center justify-center hover:opacity-80 transition-opacity">
        <img src="/images/global/youtube-icon-figma.png" alt="YouTube" class="w-8 h-8 object-contain" />
      </a>
    </div>

    <!-- Footer navigation -->
    <div class="flex flex-wrap justify-center gap-4 md:gap-12 mb-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="font-aktiv text-kd-navy font-medium text-[13px] tracking-[1.3px] hover:text-kd-gold transition-colors uppercase"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Tools and resources: these pages were orphaned (no incoming internal
         links anywhere on the site), so they received no crawl priority and
         no visitor could navigate to them. -->
    <div class="flex flex-wrap justify-center gap-3 md:gap-8 mb-10">
      {toolLinks.map((link) => (
        <a
          href={link.href}
          class="font-montserrat text-kd-grey font-light text-[12px] tracking-[0.8px] hover:text-kd-gold transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>

  <!-- Copyright bar — cream background -->
  <div class="bg-kd-cream">
    <div class="max-w-6xl mx-auto px-6 py-5 flex flex-col md:flex-row justify-between items-center">
      <p class="text-kd-grey text-[12px] leading-[18px] tracking-[1.2px] font-montserrat font-light">{currentYear} &copy; Kinga Dow. All rights reserved</p>
      <a href="/privacy/" class="text-kd-grey text-[12px] leading-[18px] tracking-[1.2px] font-montserrat font-light hover:text-kd-gold transition-colors mt-3 md:mt-0 underline">
        Privacy Policy
      </a>
    </div>
  </div>
</footer>
