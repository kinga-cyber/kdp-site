---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ConsultationCTA from "../components/ConsultationCTA.astro";

// Pull all non-draft posts, newest first
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Split into featured (max 2) and popular (the rest)
const featuredPosts = allPosts.filter((p) => p.data.featured).slice(0, 2);
const featuredSlugs = new Set(featuredPosts.map((p) => p.id));
const popularPosts = allPosts.filter((p) => !featuredSlugs.has(p.id));

// Unique category list for the filter pills (sorted alphabetically)
const categories = Array.from(
  new Set(allPosts.map((p) => p.data.category))
).sort();

// Standard date formatter
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

// How many popular posts to show before Load More kicks in
const INITIAL_VISIBLE = 9;
---

<Layout
  title="Blog | Kinga Dow - Retention Marketing Insights"
  description="Browse our blog for tutorials and other informational resources on email marketing, retention strategies, and eCommerce growth."
>
  <!-- Hero Section -->
  <section class="hero-gradient relative py-16 md:py-24 overflow-hidden">
    <!-- Decorative circle pattern - left side -->
    <div class="absolute -left-20 top-16 w-[380px] h-[380px] opacity-30 pointer-events-none">
      <img src="/images/home/decorative/bg-circle-left.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>
    <!-- Decorative circle pattern - bottom right -->
    <div class="absolute -right-16 -bottom-16 w-[300px] h-[300px] opacity-20 pointer-events-none">
      <img src="/images/home/decorative/bg-circle.png" alt="" class="w-full h-full object-contain" aria-hidden="true" />
    </div>

    <div class="max-w-6xl mx-auto px-6 text-center relative z-10">
      <!-- Label: Gold uppercase -->
      <span class="animate-on-scroll fade-in-up font-aktiv text-kd-gold font-medium text-[14px] leading-[17px] tracking-[1.4px] mb-4 block uppercase">
        Blog
      </span>

      <!-- Headline -->
      <h1 class="font-aktiv text-kd-navy text-[24px] md:text-[42px] leading-[36px] md:leading-[52px] tracking-[1.4px] md:tracking-[2.1px] font-semibold max-w-4xl mx-auto">
        Browse our blog for tutorials<br class="hidden md:block" />and other informational resources
      </h1>
    </div>
  </section>

  {featuredPosts.length > 0 && (
    <!-- Featured Posts Section -->
    <section class="py-12 md:py-16 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <!-- Section Header -->
        <h2 class="animate-on-scroll fade-in-up font-aktiv text-kd-navy text-[21px] md:text-[28px] font-semibold tracking-[1.2px] md:tracking-[1.4px] mb-8">
          Featured Posts
        </h2>

        <!-- Featured Posts Grid -->
        <div class="grid md:grid-cols-12 gap-6 md:gap-8">
          <!-- Main Featured Post (larger) -->
          {featuredPosts[0] && (
            <div class="md:col-span-7 animate-on-scroll fade-in-up">
              <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <a href={`/blog/${featuredPosts[0].id}`} class="block aspect-video bg-kd-cream relative overflow-hidden">
                  <img
                    src={featuredPosts[0].data.image}
                    alt={featuredPosts[0].data.imageAlt ?? featuredPosts[0].data.title}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                  />
                </a>

                <div class="p-6">
                  <span class="text-kd-gold text-[12px] md:text-[13px] font-montserrat font-medium tracking-[1.2px] uppercase">
                    {featuredPosts[0].data.category}
                  </span>

                  <h3 class="font-aktiv text-kd-navy text-[18px] md:text-[22px] font-semibold leading-[26px] md:leading-[30px] tracking-[0.9px] md:tracking-[1.1px] mt-2 mb-2">
                    <a href={`/blog/${featuredPosts[0].id}`} class="hover:text-kd-gold transition-colors">
                      {featuredPosts[0].data.title}
                    </a>
                  </h3>

                  <p class="text-kd-grey text-[12px] md:text-[13px] font-montserrat tracking-[1.2px] mb-3">
                    {formatDate(featuredPosts[0].data.date)}
                  </p>

                  <p class="text-kd-grey text-[14px] md:text-[15px] leading-[22px] md:leading-[24px] font-montserrat font-light tracking-[0.7px] mb-4">
                    {featuredPosts[0].data.excerpt}
                  </p>

                  <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
                    <div class="w-8 h-8 rounded-full bg-kd-cream flex items-center justify-center">
                      <span class="text-kd-navy text-[12px] font-montserrat font-medium">
                        {featuredPosts[0].data.author.charAt(0)}
                      </span>
                    </div>
                    <span class="text-kd-navy text-[13px] font-montserrat font-medium tracking-[0.6px]">
                      {featuredPosts[0].data.author}
                    </span>
                  </div>
                </div>
              </article>
            </div>
          )}

          {featuredPosts[1] && (
            <div class="md:col-span-5 animate-on-scroll fade-in-up delay-100">
              <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow h-full flex flex-col">
                <a href={`/blog/${featuredPosts[1].id}`} class="block aspect-video bg-kd-cream relative overflow-hidden">
                  <img
                    src={featuredPosts[1].data.image}
                    alt={featuredPosts[1].data.imageAlt ?? featuredPosts[1].data.title}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                  />
                </a>

                <div class="p-6 flex-1 flex flex-col">
                  <span class="text-kd-gold text-[12px] md:text-[13px] font-montserrat font-medium tracking-[1.2px] uppercase">
                    {featuredPosts[1].data.category}
                  </span>

                  <h3 class="font-aktiv text-kd-navy text-[16px] md:text-[18px] font-semibold leading-[24px] md:leading-[26px] tracking-[0.8px] md:tracking-[0.9px] mt-2 mb-2">
                    <a href={`/blog/${featuredPosts[1].id}`} class="hover:text-kd-gold transition-colors">
                      {featuredPosts[1].data.title}
                    </a>
                  </h3>

                  <p class="text-kd-grey text-[12px] md:text-[13px] font-montserrat tracking-[1.2px] mb-3">
                    {formatDate(featuredPosts[1].data.date)}
                  </p>

                  <p class="text-kd-grey text-[13px] md:text-[14px] leading-[20px] md:leading-[22px] font-montserrat font-light tracking-[0.7px] mb-4 flex-1">
                    {featuredPosts[1].data.excerpt}
                  </p>

                  <div class="flex items-center gap-3 pt-4 border-t border-gray-100 mt-auto">
                    <div class="w-8 h-8 rounded-full bg-kd-cream flex items-center justify-center">
                      <span class="text-kd-navy text-[12px] font-montserrat font-medium">
                        {featuredPosts[1].data.author.charAt(0)}
                      </span>
                    </div>
                    <span class="text-kd-navy text-[13px] font-montserrat font-medium tracking-[0.6px]">
                      {featuredPosts[1].data.author}
                    </span>
                  </div>
                </div>
              </article>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Popular Posts Section -->
  <section class="py-12 md:py-16 px-6 bg-[#FAFAFA]">
    <div class="max-w-6xl mx-auto">
      <!-- Section Header + Category Filter -->
      <div class="animate-on-scroll fade-in-up mb-8">
        <h2 class="font-aktiv text-kd-navy text-[21px] md:text-[28px] font-semibold tracking-[1.2px] md:tracking-[1.4px] mb-4">
          Popular Posts
        </h2>

        <!-- Category filter pills -->
        <div id="category-filter" class="flex flex-wrap gap-2">
          <button
            type="button"
            data-category-filter="all"
            class="category-pill is-active px-4 py-1.5 rounded-full text-[12px] font-montserrat font-medium tracking-[1.1px] uppercase transition-colors"
          >
            All
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              data-category-filter={cat}
              class="category-pill px-4 py-1.5 rounded-full text-[12px] font-montserrat font-medium tracking-[1.1px] uppercase transition-colors"
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Posts Grid -->
      <div id="posts-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {popularPosts.map((post, index) => (
          <article
            class="post-card animate-on-scroll fade-in-up bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow"
            data-category={post.data.category}
            data-index={index}
            style={`animation-delay: ${(index % 3) * 0.05}s; ${index >= INITIAL_VISIBLE ? "display: none;" : ""}`}
          >
            <a href={`/blog/${post.id}`} class="block aspect-video bg-kd-cream relative overflow-hidden">
              <img
                src={post.data.image}
                alt={post.data.imageAlt ?? post.data.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              />
            </a>

            <div class="p-5">
              <span class="text-kd-gold text-[11px] md:text-[12px] font-montserrat font-medium tracking-[1.1px] uppercase">
                {post.data.category}
              </span>

              <h3 class="font-aktiv text-kd-navy text-[15px] md:text-[16px] font-semibold leading-[22px] md:leading-[24px] tracking-[0.75px] md:tracking-[0.8px] mt-2 mb-2">
                <a href={`/blog/${post.id}`} class="hover:text-kd-gold transition-colors line-clamp-2">
                  {post.data.title}
                </a>
              </h3>

              <p class="text-kd-grey text-[11px] md:text-[12px] font-montserrat tracking-[1.1px] mb-2">
                {formatDate(post.data.date)}
              </p>

              <p class="text-kd-grey text-[13px] md:text-[14px] leading-[20px] md:leading-[22px] font-montserrat font-light tracking-[0.65px] mb-4 line-clamp-3">
                {post.data.excerpt}
              </p>

              <div class="flex items-center gap-2 pt-3 border-t border-gray-100">
                <div class="w-7 h-7 rounded-full bg-kd-cream flex items-center justify-center">
                  <span class="text-kd-navy text-[11px] font-montserrat font-medium">
                    {post.data.author.charAt(0)}
                  </span>
                </div>
                <span class="text-kd-navy text-[12px] font-montserrat font-medium tracking-[0.6px]">
                  {post.data.author}
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty state for filter (hidden by default) -->
      <p id="empty-state" class="hidden text-center text-kd-grey text-[14px] font-montserrat tracking-[0.6px] mt-8">
        No posts in this category yet.
      </p>

      <!-- Load More Button -->
      {popularPosts.length > INITIAL_VISIBLE && (
        <div class="animate-on-scroll fade-in-up text-center mt-10">
          <button
            id="load-more"
            type="button"
            class="btn-gold px-8 py-3.5 rounded-lg text-[14px] font-montserrat font-medium tracking-[1.4px] inline-flex items-center gap-3 hover:opacity-90 transition-opacity"
          >
            <span>LOAD MORE</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      )}
    </div>
  </section>

  <!-- Consultation CTA -->
  <ConsultationCTA />
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .category-pill {
    background: #ffffff;
    color: #3F455D;
    border: 1px solid rgba(63, 69, 93, 0.15);
  }

  .category-pill:hover {
    border-color: #BA9200;
    color: #BA9200;
  }

  .category-pill.is-active {
    background: #BA9200;
    color: #ffffff;
    border-color: #BA9200;
  }
</style>

<script>
  // Category filter + Load More for the popular posts grid
  const filterContainer = document.getElementById("category-filter");
  const grid = document.getElementById("posts-grid");
  const emptyState = document.getElementById("empty-state");
  const loadMoreBtn = document.getElementById("load-more");
  const INITIAL_VISIBLE = 9;

  let activeCategory: string = "all";
  let isExpanded = false;

  const allCards = grid
    ? Array.from(grid.querySelectorAll<HTMLElement>(".post-card"))
    : [];

  function applyFilter() {
    let visibleCount = 0;
    let matchedCount = 0;

    allCards.forEach((card, idx) => {
      const cardCategory = card.dataset.category ?? "";
      const matchesCategory =
        activeCategory === "all" || cardCategory === activeCategory;

      if (!matchesCategory) {
        card.style.display = "none";
        return;
      }

      matchedCount++;

      // Within matched cards, only show first INITIAL_VISIBLE unless expanded
      if (isExpanded || matchedCount <= INITIAL_VISIBLE) {
        card.style.display = "";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    // Empty state
    if (emptyState) {
      emptyState.classList.toggle("hidden", matchedCount > 0);
    }

    // Load More visibility
    if (loadMoreBtn) {
      const hasHiddenInCategory = matchedCount > visibleCount;
      loadMoreBtn.parentElement!.style.display = hasHiddenInCategory
        ? ""
        : "none";
    }
  }

  if (filterContainer) {
    filterContainer.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-category-filter]"
      );
      if (!target) return;

      filterContainer
        .querySelectorAll(".category-pill")
        .forEach((pill) => pill.classList.remove("is-active"));
      target.classList.add("is-active");

      activeCategory = target.dataset.categoryFilter ?? "all";
      isExpanded = false; // reset on category change
      applyFilter();
    });
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener("click", () => {
      isExpanded = true;
      applyFilter();
    });
  }
</script>
